# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city_user
POSTGRES_PASSWORD=smart_city_pass
POSTGRES_PORT=5432

# Service Ports
SPRING_SERVICE_PORT=8080
FASTAPI_SERVICE_PORT=8000

# Frontend origins allowed for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000

# FastAPI optional
FASTAPI_ENV=development
CHATBOT_FOCUS_CITY=Skopje
CHATBOT_TIMEOUT_SECONDS=30
CHATBOT_PRIMARY_PROVIDER=ollama
CHATBOT_PRIMARY_MODEL=llama3.1:8b
CHATBOT_FALLBACK_PROVIDER=openrouter
CHATBOT_FALLBACK_MODEL=meta-llama/llama-3.3-8b-instruct:free
CHATBOT_OLLAMA_BASE_URL=http://localhost:11434
CHATBOT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHATBOT_OPENROUTER_API_KEY=
CHATBOT_OPENROUTER_SITE_URL=http://localhost:5173
CHATBOT_OPENROUTER_SITE_NAME=Smart City Platform

# Clerk JWT verification (Spring + FastAPI)
CLERK_ISSUER_URL=
CLERK_AUDIENCE=
CLERK_JWKS_URL=

# Pulse Eco integration (FastAPI)
PULSE_CITY=skopje
PULSE_BASE_URL=
PULSE_TIMEOUT_SECONDS=10
PULSE_USERNAME=
PULSE_PASSWORD=
POLLUTION_STARTUP_FETCH=true
POLLUTION_STALE_AFTER_MINUTES=120
POLLUTION_HISTORY_CACHE_TTL_MINUTES=15
