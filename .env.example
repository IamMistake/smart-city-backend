# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city_user
POSTGRES_PASSWORD=smart_city_pass
POSTGRES_PORT=5432

# Service Ports
SPRING_SERVICE_PORT=8080
FASTAPI_SERVICE_PORT=8000

# Frontend origins allowed for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# FastAPI optional
FASTAPI_ENV=development

# Clerk JWT verification (FastAPI)
CLERK_ISSUER_URL=
CLERK_AUDIENCE=
CLERK_JWKS_URL=
